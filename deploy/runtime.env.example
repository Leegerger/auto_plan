# Secret-free names only. Supply credentials from the runtime secret provider.
AUTO_PLAN_BASE_PATH=/auto_plan
AUTO_PLAN_PUBLIC_ORIGIN=https://fsscm.cminl.oa
AUTO_PLAN_ORACLE_USER=PLAN_PROD
AUTO_PLAN_ORACLE_CLIENT_PATH=/opt/oracle
AUTO_PLAN_ORACLE_POOL_MAX=10
AUTO_PLAN_AUTH_CA_FILE=/run/auto-plan/company-ca.crt
AUTO_PLAN_AUTH_URL=https://psamv4athefs.cminl.oa/api/SSO/Login
AUTO_PLAN_TEST_AUTH_ENABLED=false
AUTO_PLAN_JOB_QUEUE_CAPACITY=20
# Omit JOB_WORKERS to reserve one allocated CPU for API/controller.
# AUTO_PLAN_JOB_WORKERS=1
AUTO_PLAN_PROXY_TRUSTED_IPS=127.0.0.1
AUTO_PLAN_ADOPTION_SPACE_WARNING_BYTES=1073741824
# Required runtime values, deliberately unset here:
# AUTO_PLAN_ORACLE_PASSWORD
# AUTO_PLAN_ORACLE_DSN
# AUTO_PLAN_INITIAL_ADMIN_ID
